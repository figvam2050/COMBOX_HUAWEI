# Нормалізація рядків для спільної роботи (Windows/macOS/Linux):
# у репозиторії — LF, checkout конвертує під ОС розробника автоматично.
* text=auto

# Бінарі — ніколи не чіпати.
*.bin binary
*.elf binary
*.o binary
*.a binary
*.png binary
*.jpg binary

# Прошивки у текстовому hex-форматі — тримати текстом (дифф-и читабельні).
*.hex text
*.py text
*.md text
